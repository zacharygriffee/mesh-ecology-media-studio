{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mesh-ecology.example/schemas/media-provider-adapter-run-local.schema.json",
  "title": "media.provider_adapter_run.local.v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "adapterRunId",
    "adapterId",
    "providerId",
    "endpointId",
    "requestRef",
    "mode",
    "providerInputSummary",
    "providerResultRef",
    "status",
    "failureEvidenceRefs",
    "startedAt",
    "completedAt",
    "localOnly",
    "meshTruth",
    "distributedProof",
    "ratifiedSharedState",
    "providerTruth",
    "localTruthLabel",
    "truthStatus",
    "createdAt"
  ],
  "properties": {
    "schema": {
      "const": "media.provider_adapter_run.local.v1"
    },
    "adapterRunId": {
      "type": "string",
      "minLength": 1
    },
    "adapterId": {
      "type": "string",
      "minLength": 1
    },
    "providerId": {
      "type": "string",
      "minLength": 1
    },
    "endpointId": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "dry-run",
        "live-smoke"
      ]
    },
    "providerInputSummary": {
      "type": "object"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "failureEvidenceRefs": {
      "type": "array"
    },
    "localOnly": {
      "const": true
    },
    "meshTruth": {
      "const": false
    },
    "distributedProof": {
      "const": false
    },
    "ratifiedSharedState": {
      "const": false
    },
    "providerTruth": {
      "const": false
    }
  }
}
