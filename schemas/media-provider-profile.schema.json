{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mesh-ecology.example/schemas/media-provider-profile.schema.json",
  "title": "media.provider_profile.v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "providerId",
    "displayName",
    "capabilities",
    "localOnly",
    "meshTruth",
    "createdAt"
  ],
  "properties": {
    "schema": {
      "const": "media.provider_profile.v1"
    },
    "providerId": {
      "type": "string",
      "minLength": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "localOnly": {
      "const": true
    },
    "meshTruth": {
      "const": false
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
