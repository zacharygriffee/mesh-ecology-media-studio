    "mode": {
      "const": "standalone-local"
    },
    "proofState": {
      "enum": ["ready", "attention"]
    },
    "steps": {
      "type": "array"
    },
    "refs": {
      "type": "object"
    },
    "summary": {
      "type": "object"
    },
    "localPackagePosture": {
      "type": "object"
    },
    "swarmSeamPosture": {
      "type": "object"
    },
    "studioSourcePressureAdapterSummary": {
      "type": "object"
    },
    "warnings": {
      "type": "array"
    },
    "operatorGuidanceOnly": {
      "const": true
    },
    "localOnly": {
      "const": true
    },
    "meshTruth": {
      "const": false
    },
    "distributedProof": {
      "const": false
    },
    "ratifiedSharedState": {
      "const": false
    },
    "providerTruth": {
      "const": false
    },
    "edgeRuntimeBuilt": {
      "const": false
    },
    "edgeRuntimeVerified": {
      "const": false
    }
  }
}
