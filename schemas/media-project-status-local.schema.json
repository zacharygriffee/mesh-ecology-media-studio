{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mesh-ecology.example/schemas/media-project-status-local.schema.json",
  "title": "media.project_status.local.v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "statusId",
    "projectId",
    "createdAt",
    "mode",
    "counts",
    "latestRefs",
    "warnings",
    "localOnly",
    "meshTruth",
    "distributedProof",
    "ratifiedSharedState",
    "providerTruth",
    "byteAvailabilityProof",
    "materializationProof",
    "localTruthLabel",
    "truthStatus"
  ],
  "properties": {
    "schema": {
      "const": "media.project_status.local.v1"
    },
    "statusId": {
      "type": "string",
      "minLength": 1
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "const": "standalone-local"
    },
    "counts": {
      "type": "object"
    },
    "latestRefs": {
      "type": "object"
    },
    "warnings": {
      "type": "array"
    },
    "localOnly": {
      "const": true
    },
    "meshTruth": {
      "const": false
    },
    "distributedProof": {
      "const": false
    },
    "ratifiedSharedState": {
      "const": false
    },
    "providerTruth": {
      "const": false
    },
    "byteAvailabilityProof": {
      "const": false
    },
    "materializationProof": {
      "const": false
    }
  }
}
