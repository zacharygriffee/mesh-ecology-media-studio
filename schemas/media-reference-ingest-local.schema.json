{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mesh-ecology.example/schemas/media-reference-ingest-local.schema.json",
  "title": "media.reference_ingest.local.v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "ingestId",
    "projectId",
    "sourceRef",
    "assetRef",
    "assetRecordRef",
    "createdAt",
    "localOnly",
    "meshTruth",
    "distributedProof",
    "ratifiedSharedState",
    "providerTruth",
    "byteAvailabilityProof",
    "materializationProof",
    "localTruthLabel",
    "truthStatus"
