    },
    "ingestId": {
      "type": "string",
      "minLength": 1
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "sourceRef": {
      "type": "object"
    },
    "assetRef": {
      "type": "object"
    },
    "assetRecordRef": {
      "type": "object"
    },
    "imageMetadataRef": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "localOnly": {
      "const": true
    },
    "meshTruth": {
      "const": false
    },
    "distributedProof": {
      "const": false
    },
    "ratifiedSharedState": {
      "const": false
    },
    "providerTruth": {
      "const": false
    },
    "byteAvailabilityProof": {
      "const": false
    },
    "materializationProof": {
      "const": false
    }
  }
}
