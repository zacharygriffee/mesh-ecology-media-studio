    "exportPerformed": {
      "const": true
    },
    "deliveryCreated": {
      "const": true
    },
    "productionReady": {
      "const": false
    },
    "publicationAuthorization": {
      "const": false
    },
    "localOnly": {
      "const": true
    },
    "meshTruth": {
      "const": false
    }
  }
}
