    "exportReceiptId",
    "projectId",
    "mode",
    "exportKind",
    "sourceExportPlanRef",
    "sourceExportCandidateRef",
    "sourceRenderReceiptRef",
    "sourceOutputLocalRef",
    "deliveryLocalRef",
