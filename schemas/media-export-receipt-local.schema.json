    "executionPosture",
    "sourceRefs",
    "createdAt",
    "operatorGuidanceOnly",
    "exportPerformed",
    "deliveryCreated",
    "productionReady",
    "publicationAuthorization",
    "localOnly",
    "meshTruth"
