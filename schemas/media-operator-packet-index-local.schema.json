    "healthRefs": {
      "type": "array"
    },
    "handoffCandidateRefs": {
      "type": "array"
    },
    "operatorDecisionRequestRefs": {
      "type": "array"
    },
    "summary": {
      "type": "object"
    },
    "warnings": {
      "type": "array"
    },
    "operatorGuidanceOnly": {
      "const": true
    },
    "localOnly": {
      "const": true
    },
    "meshTruth": {
      "const": false
    },
    "distributedProof": {
      "const": false
    },
    "ratifiedSharedState": {
      "const": false
    },
    "providerTruth": {
      "const": false
    },
    "edgeRuntimeVerified": {
      "const": false
