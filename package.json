{
  "name": "mesh-ecology-media-studio",
  "version": "0.1.0",
  "description": "Media-domain frontier for mesh ecology Studio workflows.",
  "type": "module",
  "private": false,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "inspect:local-run": "node src/seams/inspect-local-run.js",
    "inspect:index": "node src/seams/index-inspection-records.js",
