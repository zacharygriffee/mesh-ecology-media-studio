    "promote:candidate": "node src/local/promote-candidate.js",
    "fixture:inspection": "node src/local/generate-inspection-fixture.js",
    "wedge:example": "node src/local/run-first-wedge.js --project-dir examples/card-to-candidate --decision accepted",
    "test": "node --test test/*.test.js"
  },
  "repository": {
